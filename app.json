{
  "expo": {
    "name": "Dose Tracker",
    "slug": "dosetracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dosetracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-ios.png",
      "bundleIdentifier": "com.vericodestudio.dosetracker",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "DoseTracker rings an alarm at your medication times until you stop it.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#91A9ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.vericodestudio.dose_tracker",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withIosLocalNotificationsOnly.cjs",
      "./plugins/withIosSceneLifecycle.cjs",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#08B8BE",
          "sounds": [
            "./assets/sounds/gentle.wav",
            "./assets/sounds/clear.wav"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DoseTracker to use Face ID to protect your health information."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo stored only on this device.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F3",
          "image": "./assets/images/splash-icon-upscaled.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0A111D",
            "image": "./assets/images/splash-icon-upscaled.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": false
          }
        }
      ],
      "./plugins/withAndroidRelease.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac54bbe7-d6eb-420c-b576-ba1f2b298d80"
      }
    },
    "owner": "vericode"
  }
}
